{
  "name": "poe2-build-planner-claude-tool",
  "version": "0.0.1",
  "description": "Free Claude Desktop Extension that turns a PoE2 play fantasy into a playable build.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:summary": "tsx scripts/data-summary.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "tsx src/server.ts",
    "package": "tsx scripts/package.ts"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
